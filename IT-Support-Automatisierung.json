    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n\"type\": \"object\",\n\"properties\": {\n\"bekanntes_problem\": {\n\"type\": \"boolean\",\n\"description\": \"Gibt an, ob das aktuelle Problem bereits als gleiches oder im Wesentlichen gleiches Problem im Archiv bekannt ist.\"\n},\n\"gleiche_probleme\": {\n\"type\": \"array\",\n\"description\": \"Archivierte Tickets mit demselben oder im Wesentlichen demselben Problem. Bei unbekannten Problemen ist dieses Array leer.\",\n\"items\": {\n\"type\": \"object\",\n\"properties\": {\n\"ticketnummer\": {\n\"type\": \"string\",\n\"description\": \"Ticketnummer des archivierten Tickets.\"\n},\n\"originale_anfrage\": {\n\"type\": \"string\",\n\"description\": \"Originale Anfrage des archivierten Tickets.\"\n},\n\"problemzusammenfassung\": {\n\"type\": \"string\",\n\"description\": \"Zusammenfassung des Problems aus dem archivierten Ticket.\"\n},\n\"loesung\": {\n\"type\": \"string\",\n\"description\": \"Im archivierten Ticket dokumentierte Lösung.\"\n}\n},\n\"required\": [\n\"ticketnummer\",\n\"originale_anfrage\",\n\"problemzusammenfassung\",\n\"loesung\"\n],\n\"additionalProperties\": false\n}\n},\n\"aehnliche_probleme\": {\n\"type\": \"array\",\n\"description\": \"Archivierte Tickets mit ähnlichen Problemen, deren Lösungen bei der Bearbeitung des aktuellen Problems hilfreich sein können. Bei bekannten Problemen ist dieses Array leer.\",\n\"items\": {\n\"type\": \"object\",\n\"properties\": {\n\"ticketnummer\": {\n\"type\": \"string\",\n\"description\": \"Ticketnummer des archivierten Tickets.\"\n},\n\"originale_anfrage\": {\n\"type\": \"string\",\n\"description\": \"Originale Anfrage des archivierten Tickets.\"\n},\n\"problemzusammenfassung\": {\n\"type\": \"string\",\n\"description\": \"Zusammenfassung des ähnlichen Problems.\"\n},\n\"loesung\": {\n\"type\": \"string\",\n\"description\": \"Im archivierten Ticket dokumentierte Lösung, die als Hilfestellung dienen kann.\"\n}\n},\n\"required\": [\n\"ticketnummer\",\n\"originale_anfrage\",\n\"problemzusammenfassung\",\n\"loesung\"\n],\n\"additionalProperties\": false\n}\n}\n},\n\"required\": [\n\"bekanntes_problem\",\n\"gleiche_probleme\",\n\"aehnliche_probleme\"\n],\n\"additionalProperties\": false\n}\n"
      },
